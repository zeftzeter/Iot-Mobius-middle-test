# nCube TAS connection used by device/sonic.py
NCUBE_TAS_HOST=127.0.0.1
NCUBE_TAS_PORT=3105
NCUBE_CONTAINER=sonic

# HC-SR04 GPIO numbers in BCM mode
ULTRASONIC_TRIG_BCM=23
ULTRASONIC_ECHO_BCM=24
ULTRASONIC_ECHO_TIMEOUT=0.05

# nCube to Mobius connection used by ncube/conf.example.js
MOBIUS_HOST=192.168.137.1
MOBIUS_PORT=7579
NCUBE_AE_NAME=jjh-sonic